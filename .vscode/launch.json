    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "UsersServiceApplication",
            "request": "launch",
            "mainClass": "com.users.users_service.UsersServiceApplication",
            "projectName": "users-service",
            "env": {
                "DB_URL": "jdbc:postgresql://localhost:5432/users_db",
                "DB_USERNAME": "users_app",
                "DB_PASSWORD": "prueba123!"
            }
        },
        {
            "type": "java",
            "name": "AuthServiceApplication",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "com.auth.auth_service.AuthServiceApplication",
            "projectName": "auth-service",
            "env": {
                "USERS_SERVICE_URL": "http://localhost:8082"
            }
        }
    ]
}
